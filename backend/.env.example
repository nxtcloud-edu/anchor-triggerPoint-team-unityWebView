# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 깃에 올리지 않는다.
TZ=Asia/Seoul
PORT=80

# s3: anchor-edu-01-s3 버킷 사용 (EC2 역할로 자동 인증) / fs: DATA_DIR 폴더 사용 (로컬 개발용)
STORAGE=s3
S3_BUCKET=anchor-edu-01-s3
AWS_REGION=us-east-1
DATA_DIR=./data

# 관리자 로그인
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 로그인 토큰 서명용 긴 임의 문자열 (예: openssl rand -hex 32)
AUTH_SECRET=

# (선택) 화면을 다른 주소(S3 정적 호스팅 등)에서 열 때 허용할 주소, 쉼표로 구분
CORS_ORIGINS=
# (선택) 값을 넣으면 유니티가 X-Ingest-Key 헤더로 같은 값을 보내야 세션을 받는다
INGEST_KEY=

# 100m에서 한 클릭이 움직이는 거리(cm) — 유니티 WindageClickCmAt100m / ElevationClickCmAt100m
CLICK_CM_AT_100M_H=3
CLICK_CM_AT_100M_V=3

# 집계에 넣을 표적 프로필 (쉼표로 구분). 탄창을 다 쏜(MagazineEmpty) 세션만 집계한다
COUNTED_TARGET_PROFILES=IndoorTargetScore

# (선택) 시뮬레이터 대수. 값을 넣으면 서버를 켤 때 저장된 대수를 이 값으로 바꾼다 (처음 값 1)
SIMULATOR_COUNT=
