{
  "name": "trigger-point-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "recompute": "tsx src/scripts/recompute.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:clear": "tsx src/scripts/seed.ts --clear"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
