# 백엔드 API 주소. 비워 두면 같은 주소의 /api 로 요청하고 개발 서버가 VITE_PROXY_TARGET 으로 넘긴다
# (화면을 S3 등 다른 곳에서 열 때만 http://<서버 주소> 를 넣는다)
VITE_SERVER_URL=
# 개발 서버(pnpm dev)가 /api 요청을 넘길 데이터 서버. EC2에서는 기본값 그대로 (backend 가 80 포트)
VITE_PROXY_TARGET=http://localhost:80
# 목(더미 데이터) 모드. 기본값 true — 로그인 화면에 「개발자 로그인」이 보인다
# 실제 서버의 데이터를 보려면 false 로 둔다
VITE_USE_MOCK=true
